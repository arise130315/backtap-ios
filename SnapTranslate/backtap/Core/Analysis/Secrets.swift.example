//  使用步骤:
//  1. 复制本文件为 Secrets.swift (同目录,去掉 .example 后缀)
//  2. 把下面 PASTE_YOUR_QWEN_API_KEY_HERE 替换成你在
//     https://bailian.console.aliyun.com 创建的 API Key (sk- 开头)
//  3. Cmd+R 运行
//
//  注意: Secrets.swift 已在 .gitignore 中,不会被提交到 git。
//

import Foundation

enum Secrets {
    /// 阿里千问 (DashScope) API Key, 用于图片分析功能 (qwen3-vl-flash)。
    /// 在 https://bailian.console.aliyun.com → API Key 管理 创建。
    static let qwenAPIKey = "PASTE_YOUR_QWEN_API_KEY_HERE"
}
